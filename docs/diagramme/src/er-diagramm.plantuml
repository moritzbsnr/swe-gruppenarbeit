' Preview durch <Alt>d

@startuml ER Diagramm

hide circle
skinparam linetype ortho

entity "Film" {
  * id : integer <<generated>>
  --
  * titel : text
  * erscheinungsjahr : integer
}

entity "Drehbuch" {
  * id : integer <<generated>>
  --
  * titel : text
  * autor : text
  * seitenzahl : integer
  * **Film_id**: integer <<FK>>
}

entity "Schauspieler" {
  * id : integer <<generated>>
  --
  * vorname : text
  * nachname : text
  * **film_id** : integer <<FK>>
}

Film ||--|| Drehbuch
Film ||--|{ Schauspieler

@enduml
