' Preview durch <Alt>d

@startuml Schichtenarchitektur

package film #DDDDDD {
    package rest #FFFFFF {
        [@router.get()\nget_by_id()\n\n@router.get()\nget()\n\n@router.get()\nget_nachnamen()] as FilmGetController
        [@router.post()\npost()\n\n@router.put()\nput()\n\n@router.delete()\ndelete_by_id()] as FilmWriteController
        [@router.get()\nliveness()\n\n@router.get()\nreadiness()] as HealthController

        [FilmGetController] -right[hidden]-> [FilmWriteController]
    }

    package service #FFFFFF {
        [find_by_id()\nfind()\nfind_nachnamen()] as FilmReadService
        [create()\nupdate()\ndelete()] as FilmWriteService
    }

    [FilmGetController] --> [FilmReadService]
    [FilmWriteController] --> [FilmWriteService]

    package repository #FFFFFF {
        [find_by_id()\nfind()\nexists_email()\nfind_nachnamen()\ncreate()\nupdate()\ndelete_by_id()\ncheck_db_connection()] as PatientRepository
    }

    [FilmReadService] --> [FilmRepository]
    [FilmWriteService] --> [FilmRepository]
    [HealthController] --> [FilmRepository]

    package entity #FFFFFF {
        [Film]
        [Drehbuch]
        [Schauspieler]

        [Film] -right[hidden]-> [Drehbuch]
        [Drehbuch] -down[hidden]-> [Schauspieler]
    }

    [FilmGetController] ..> [Film]
    [FilmWriteController] ..> [Film]
    [FilmReadService] .left.> [Film]
    [FilmWriteService] ..> [Film]
    [FilmRepository] ..> [Film]
}

RESTClient ~~> [FilmGetController]
RESTClient ~~> [FilmWriteController]
RESTClient ~~> [HealthController]

cloud {
    [SQLAlchemy\n(OR-Mapping)] as SQLAlchemy
}

[FilmRepository] ~down~> [SQLAlchemy]
entity ~~> [SQLAlchemy]

database "DB film" as db {
    [Tabelle film]
    [Tabelle drehbuch]
    [Tabelle schauspieler]
}

[SQLAlchemy] ~down~> db

@enduml
