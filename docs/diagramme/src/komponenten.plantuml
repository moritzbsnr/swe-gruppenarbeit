' Preview durch <Alt>d

@startuml Komponenten

left to right direction

actor RESTClient
actor GraphQLClient

node "film" {
  [film_router]
  [film_write_router]
  [schema]

  [film_read_service]
  [film_write_service]

  [film_repository]

  [mailer]
}


cloud {
    [SQLAlchemy]
}

cloud {
    [smtp]
}

database "DB film" {
    [Tabelle film]
    [Tabelle drehbuch]
    [Tabelle schauspieler]
}

node {
    [Mailserver]
}

RESTClient ~~> [film_router]
RESTClient ~~> [film_write_router]
GraphQLClient ~~> [schema]

[film_router] ..> [film_read_service]
[film_write_router] ..> [film_write_service]
[schema] ..> [film_read_service]
[schema] ..> [film_write_service]
[film_read_service] ..> [film_repository]
[film_write_service] ..> [film_repository]

[film_repository] ~~> [SQLAlchemy]
[SQLAlchemy] ~~> [Tabelle film]
[SQLAlchemy] ~~> [Tabelle drehbuch]
[SQLAlchemy] ~~> [Tabelle schauspieler]

[film_write_service] ..> [mailer]
[mailer] ~~> [smtp]
[smtp] ~~> [Mailserver]

@enduml
